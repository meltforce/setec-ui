# Generated by `make project` from project.yml. Never committed. Info.plist and
# App.entitlements are generated too: project.yml declares them under
# `info.path` and `entitlements.path` and xcodegen rewrites both on every run.
*.xcodeproj
*.xcworkspace
Resources/Info.plist
Resources/App.entitlements

# Build products and the agent's screenshots
.build/
.agent/
DerivedData/

# Claude Code. Project scope belongs in the repo; session and machine state
# does not. Ignore the directory *contents* rather than the directory itself.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/project-standards.json
.claude/settings.local.json

# macOS
.DS_Store
._*
